# 复制为 .env 后填入真实值
# cp backend/.env.example backend/.env

# 数据库连接串（MySQL）
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/lab_agent

# JWT 配置
JWT_SECRET_KEY=please-change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# 大模型配置（OpenAI 兼容协议，可用 DeepSeek / 通义千问等）
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
